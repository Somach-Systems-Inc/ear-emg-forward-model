# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# macOS
.DS_Store

# MIDA is licensed by the IT'IS Foundation and requires individual
# registration (DOI 10.13099/ViP-MIDA-V1.0). This repo is public --
# redistributing the model here would breach that. Keep data/ local.
data/*
!data/.gitkeep
!data/README.md

# Generated meshes and E-field volumes are large and reproducible from
# the pipeline. Regenerate rather than commit.
*.msh
*.msh.opt
*.nii
*.nii.gz

# Synthetic figure fixtures (figures/mock_data.py). Deterministically
# regenerable and stamped SYNTHETIC -- never track them as if they were real
# solve output or real figures. The renderers (figures/render_*.py) and the
# generator/contract (figures/mock_data.py) ARE tracked; their outputs are not.
results/04_sensitivity_MOCK.csv
figures/MOCK_*.pdf
figures/MOCK_*.png

# SimNIBS writes a full triangulated surface of the head into every solve
# directory as *_el_currents.geo (63,582 vertices, the whole MIDA skin
# surface, ~23 MB each). That is MIDA-DERIVED GEOMETRY and redistributing it
# would breach the IT'IS licence. It is regenerated by every solve, so
# nothing is lost by refusing to track it.
*.geo
paper/_build/
